# Blender 3.5.0 MTL File: 'Flowerpots.blend'
# www.blender.org

newmtl Flowerpot
Ka 1.000000 1.000000 1.000000
Ks 0.500000 0.500000 0.500000
Ke 0.000000 0.000000 0.000000
Ni 1.450000
d 1.000000
illum 2
map_Kd Textures/Flowerpots_DIFF.png
map_Ns Textures/Flowerpots_ROUGH.png
map_Bump -bm 1.000000 Textures/Flowerpots_NORM.png

